#!/usr/bin/env bash
# Validates shell scripts with shellcheck and zsh, Python with AST parsing
# and Perl with -c
# Fails if an executable has an unrecognized shebang.
# Supported interpreters:
#   - bash, sh
#   - zsh
#   - python3
#   - perl
#
# Add unsupported executables to the explicit skip patterns above or update
# their shebangs.

set -euo pipefail

find . -type f -name 'executable_*' -print0 |
while IFS= read -r -d '' file; do
    case "$file" in
        */private_dot_config/sxhkd/executable_sxhkdrc)
            printf 'Skipping sxhkd configuration: %s\n' "$file"
            continue
            ;;
    esac

    first_line=$(sed -n '1p' "$file")

    case "$first_line" in
        '#!/bin/sh'*|'#!/usr/bin/env sh'*|'#!/bin/bash'*|'#!/usr/bin/bash'*|'#!/usr/bin/env bash'*)
            shellcheck -S error "$file"
            ;;
        '#!/bin/zsh'*|'#!/usr/bin/env zsh'*)
            zsh -n "$file"
            ;;
        '#!/usr/bin/env python'*|'#!/usr/bin/python'*|'#!/usr/bin/python3'*)
            python3 -c 'import ast, pathlib, sys; ast.parse(pathlib.Path(sys.argv[1]).read_text())' "$file"
            ;;
        '#!/usr/bin/perl'*)
            perl -c "$file"
            ;;
        '#!'*)
            printf 'Unsupported executable: %s (%s)\n' "$file" "$first_line" >&2
            exit 1
            ;;
        *)
            printf 'Executable without a recognized shebang: %s\n' "$file" >&2
            exit 1
            ;;
    esac
done
