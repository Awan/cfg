#!/bin/sh

: << 'COMMENT'
In the name of Allah, the most Gracious, the most Merciful.

 ▓▓▓▓▓▓▓▓▓▓
░▓ Author ▓ Abdullah Khabir <https://abdullah.support>
░▓▓▓▓▓▓▓▓▓▓ YouTube <https://YouTube.com/AbdullahToday>
░░░░░░░░░░

░▀█▀░█░█░█▀▄░░░░░█▀█░█▀█░▀█▀░▀█▀░█▀▀░█░█
░░█░░█▄█░█░█░░░░░█░█░█░█░░█░░░█░░█▀▀░░█░
░▀▀▀░▀░▀░▀▀░░▀▀▀░▀░▀░▀▀▀░░▀░░▀▀▀░▀░░░░▀░
COMMENT



# Monitor iwd DBus interface for state changes (suppress dbus warnings)
dbus-monitor --system "type='signal',sender='net.connman.iwd',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged'" 2>/dev/null | \
while read -r line; do
    if echo "$line" | grep -q 'string "State"'; then
        read -r next_line
        state=$(echo "$next_line" | awk -F '"' '{print $2}')
        
        case "$state" in
            "connected")
                # Get current connected SSID using iwctl
                ssid=$(iwctl station wlan0 show | awk -F'State' '{print $1}' | grep -i 'Connected network' | xargs | cut -d' ' -f3-)
                dunstify -t 3000 -i network-wireless-connected "Wi-Fi Connected" "Connected to ${ssid:-network}"
                ;;
            "disconnected")
                dunstify -u critical -t 8000 -i network-wireless-disconnected "Wi-Fi Disconnected" 
                ;;
        esac
    fi
done
