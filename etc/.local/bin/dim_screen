░▓▓▓▓▓▓▓▓▓▓ YouTube <https://YouTube.com/AbdullahToday>
░░░░░░░░░░

░█▀▄░▀█▀░█▄█░░░░░█▀▀░█▀▀░█▀▄░█▀▀░█▀▀░█▀█
░█░█░░█░░█░█░░░░░▀▀█░█░░░█▀▄░█▀▀░█▀▀░█░█
░▀▀░░▀▀▀░▀░▀░▀▀▀░▀▀▀░▀▀▀░▀░▀░▀▀▀░▀▀▀░▀░▀
'

# A shell script which dims the screen. Its a part of my BSPWM setup which uses
# xss-lock, i3lock and this script. Example to append in ~/.xprofile
# `xset s 30 60 &; xss-lock -n this_script -- i3lock -n`
# It will dim the screen's brightness with a fade after 30 seconds inactivity,
# locks the screen after 60 seconds and turn the screen off.

# Save current brightness state

light -O

# Function to restore original brightness

brighten() {
        light -I
}

# Function to fade screen out smoothly down to level 1

fade() {
    # Get integer brightness value
    local current_brightness
    current_brightness=$(light -G | cut -d "." -f 1)

    # Don't Dim the screen if brightness is 1 or 0
    if [ "$current_brightness" -le 1 ]; then
        return
    fi

    # Fade down loop (stops at brightness level 1)
    while [ "$current_brightness" -gt 1 ]; do
        current_brightness=$((current_brightness - 1))
        light -S "$current_brightness"
        sleep 0.005
    done
}


# Clean cleanup on signal/exit

cleanup() {
    # Kill background sleep if it's still running
    if [ -n "$sleep_pid" ] && kill -0 "$sleep_pid" 2>/dev/null; then
        kill "$sleep_pid" 2>/dev/null
    fi
    brighten
}

# Traps for clean exit

trap cleanup EXIT
trap 'exit 0' TERM INT

# Run dimming effect

fade

# Keep script running until killed by xss-lock on user activity

sleep 2147483647 &
sleep_pid=$!
wait "$sleep_pid"
