# Start keychain for SSH keys
if (( $+commands[keychain] )) && [[ -f "$HOME/.ssh/id_ed25519" ]]; then
    eval "$(keychain add --eval --systemd --quiet id_ed25519)"
fi

# Remap Caps Lock to Escape on virtual-console logins.
if [[ -o login && ${TTY:-} == /dev/tty<-> && -r "$HOME/.loadkeysrc" && $+commands[loadkeys] ]]; then
    if [[ $+commands[doas] ]]; then
        doas loadkeys "$HOME/.loadkeysrc"
    elif [[ $+commands[sudo] ]]; then
        sudo loadkeys "$HOME/.loadkeysrc"
    else
        print -u2 'zprofile: cannot load console keymap; neither doas nor sudo is installed.'
    fi
fi

# Start X at login on tty1
if [[ -o login && -z ${DISPLAY:-} && -z ${WAYLAND_DISPLAY:-} && ${TTY:-} == /dev/tty1 ]]; then
    exec sx
fi

# Start/attach tmux for interactive local login shells
if [[ -o interactive &&
      -z ${SSH_CONNECTION:-} &&
      -z ${TMUX:-} &&
      -t 0 &&
      $+commands[tmux] ]]; then
    if ! tmux has-session -t "$USER" 2>/dev/null; then
        tmux new-session -d -s "$USER"
    fi
    exec tmux attach-session -t "$USER"
fi
