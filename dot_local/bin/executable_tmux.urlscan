#!/usr/bin/env bash

export BROWSER=xdg-open

get_tmux_option() {
  local option=$1
  local default_value=$2
  local option_value
  option_value=$(tmux show-option -gqv "$option") || return
  if [ -z "$option_value" ]; then
    echo $default_value
  else
    echo $option_value
  fi
}

find_executable() {
  if type urlscan >/dev/null 2>&1; then
    echo "urlscan"
  elif type extract_url >/dev/null 2>&1; then
    echo "extract_url"
  fi
}

key=$(get_tmux_option "@urlscan-key" "u") || exit 1
readonly key
cmd=$(find_executable) || exit 1
readonly cmd

if [ -z "$cmd" ]; then
  tmux display-message "Failed to load tmux-urlscan: neither urlscan nor extract_url were found on the PATH"
else
  tmux bind-key "$key" capture-pane -J \\\; \
    split-window -l 10 "tmux show-buffer | BROWSER=xdg-open $cmd && tmux delete-buffer"
fi
