#!/usr/bin/env bash
set -euo pipefail

# Show battery percentage, estimated charging/discharging time, and design capacity.
# This estimate uses Linux power-supply energy counters and power readings.

SYSFS=${POWER_SUPPLY_DIR:-/sys/class/power_supply}
BATTERY_DIR=
for supply_dir in "$SYSFS"/*; do
  [[ -r "$supply_dir/type" ]] || continue
  supply_type=$(<"$supply_dir/type")
  if [[ "$supply_type" == Battery ]]; then
    BATTERY_DIR=$supply_dir
    break
  fi
done

if [[ -z "$BATTERY_DIR" ]]; then
  printf 'battery: no battery found in %s.\n' "$SYSFS" >&2
  exit 1
fi

for field in power_now energy_now energy_full energy_full_design; do
  path="$BATTERY_DIR/$field"
  if [[ ! -r "$path" ]]; then
    printf 'battery: required reading is unavailable: %s\n' "$path" >&2
    exit 1
  fi
done

POWER_SOURCE_FOUND=0
AC_ON=0
for supply_dir in "$SYSFS"/*; do
  [[ -r "$supply_dir/type" && -r "$supply_dir/online" ]] || continue
  supply_type=$(<"$supply_dir/type")
  case "$supply_type" in
    Mains|USB|USB_C|USB_PD|Wireless) ;;
    *) continue ;;
  esac

  POWER_SOURCE_FOUND=1
  source_online=$(<"$supply_dir/online")
  if [[ "$source_online" == 1 ]]; then
    AC_ON=1
    break
  elif [[ "$source_online" != 0 ]]; then
    printf 'battery: invalid online reading: %s\n' "$source_online" >&2
    exit 1
  fi
done
if (( ! POWER_SOURCE_FOUND )); then
  printf 'battery: no readable external power source found in %s.\n' "$SYSFS" >&2
  exit 1
fi

POWER_NOW=$(<"$BATTERY_DIR/power_now")
ENERGY_NOW=$(<"$BATTERY_DIR/energy_now")
ENERGY_FULL=$(<"$BATTERY_DIR/energy_full")
ENERGY_FULL_DESIGN=$(<"$BATTERY_DIR/energy_full_design")

for value in "$POWER_NOW" "$ENERGY_NOW" "$ENERGY_FULL" "$ENERGY_FULL_DESIGN"; do
  if [[ ! "$value" =~ ^[0-9]+$ ]]; then
    printf 'battery: invalid numeric reading: %s\n' "$value" >&2
    exit 1
  fi
done

if (( ENERGY_FULL == 0 || ENERGY_FULL_DESIGN == 0 )); then
  printf '%s\n' 'battery: full-capacity readings must be greater than zero.' >&2
  exit 1
fi

printf '%s%%' "$(( ENERGY_NOW * 100 / ENERGY_FULL ))"
if (( AC_ON )); then
  if (( POWER_NOW )); then
    printf ' charging in %smin' "$(( (ENERGY_FULL - ENERGY_NOW) * 60 / POWER_NOW ))"
  else
    printf ' not charging'
  fi
else
  if (( POWER_NOW )); then
    printf ' discharging in %smin' "$(( ENERGY_NOW * 60 / POWER_NOW ))"
  else
    printf ' not discharging'
  fi
fi
printf ' (%s%% of design)\n' "$(( ENERGY_FULL * 100 / ENERGY_FULL_DESIGN ))"
