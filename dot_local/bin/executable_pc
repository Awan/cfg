#!/usr/bin/env bash

# Open images in a directory with sxiv; press M to copy a selected path.

if (( $# != 1 )); then
  printf 'Usage: %s DIRECTORY\n' "$0" >&2
  exit 2
fi

pics_directory="$1"
if [[ ! -d "$pics_directory" ]]; then
  printf 'pc: directory not found: %s\n' "$pics_directory" >&2
  exit 1
fi

find "$pics_directory" -type f \( \
  -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' \
\) -print |
  sxiv -iota -N 'scratchpad_pics' 2>/dev/null
