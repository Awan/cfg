#!/bin/sh

session=${1:-tmux}
client_pid=${2:-}

case "$client_pid" in
  ''|*[!0-9]*) ;;
  *)
    client_env="/proc/$client_pid/environ"
    if [ -r "$client_env" ]; then
      display=$(tr '\0' '\n' < "$client_env" | sed -n 's/^DISPLAY=//p' | head -n 1)
      xauthority=$(tr '\0' '\n' < "$client_env" | sed -n 's/^XAUTHORITY=//p' | head -n 1)
      if [ -n "$display" ] &&
         env DISPLAY="$display" XAUTHORITY="$xauthority" xset q >/dev/null 2>&1; then
        printf 'tmux: %s' "$session"
        exit
      fi
    fi
    ;;
esac

status=

maildir=$HOME/.local/share/email/x1c/INBOX/new
if [ -d "$maildir" ]; then
  mail_count=$(find "$maildir" -type f 2>/dev/null | wc -l)
  status="${status}mail ${mail_count}  "
fi

for battery in /sys/class/power_supply/*; do
  [ -r "$battery/type" ] || continue
  IFS= read -r type < "$battery/type"
  [ "$type" = Battery ] || continue
  if [ -r "$battery/capacity" ]; then
    IFS= read -r capacity < "$battery/capacity"
    case "$capacity" in
      ''|*[!0-9]*) ;;
      *)
        battery_status=
        if [ -r "$battery/status" ]; then
          IFS= read -r battery_status < "$battery/status"
        fi
        status="${status}bat ${capacity}%${battery_status:+ $battery_status}  "
        ;;
    esac
  fi
  break
done

if command -v iw >/dev/null 2>&1; then
  wifi=$(iw dev 2>/dev/null | awk '$1 == "Interface" {print $2; exit}')
  if [ -n "$wifi" ]; then
    ssid=$(iw dev "$wifi" link 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p' | head -n 1)
    [ -z "$ssid" ] || status="${status}wifi ${ssid}  "
  fi
fi

memory=$(free 2>/dev/null | awk '/^Mem:/ {if ($2 > 0) printf "%d%%", $3 * 100 / $2}')
[ -z "$memory" ] || status="${status}ram ${memory}  "

printf '%s%s' "$status" "$(date '+%a %d-%m %H:%M')"
