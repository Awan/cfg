#!/usr/bin/env bash

# In the name of Allah, the Most Gracious, the Most Merciful.
# Send a one-shot warning when battery capacity is 70% or lower.

power_supply_dir=${POWER_SUPPLY_DIR:-/sys/class/power_supply}
battery_path=
for supply_dir in "$power_supply_dir"/*; do
  [[ -r "$supply_dir/type" && -r "$supply_dir/capacity" ]] || continue
  supply_type=$(<"$supply_dir/type")
  if [[ "$supply_type" == Battery ]]; then
    battery_path="$supply_dir/capacity"
    break
  fi
done

if [[ -z "$battery_path" ]]; then
  printf 'batLow: no readable battery capacity found in %s.\n' "$power_supply_dir" >&2
  exit 1
fi

battery_now=$(<"$battery_path")
if [[ ! "$battery_now" =~ ^[0-9]+$ ]]; then
  printf 'batLow: invalid battery capacity: %s\n' "$battery_now" >&2
  exit 1
fi

if (( battery_now <= 70 )); then
  notify-send -u critical "Battery low (${battery_now}%)"
fi
