#!/bin/sh

# ==============================================================================
# Script Name   : hotspot.sh
# Author        : Abdullah Khabir <https://abdullah.support>
# Description   : Automates creating a Wi-Fi Access Point (Hotspot) on Arch Linux
#                 sharing internet from a single wireless interface via NAT.
#                 Automatically syncs AP radio channel with upstream Wi-Fi.
# ==============================================================================
#
# 1. DEPENDENCIES
# ---------------
# Ensure the following packages are installed on your Arch Linux system:
#
#   doas pacman -S hostapd dnsmasq iptables nftables iproute2 iw rfkill
#
#
# 2. REQUIRED PRE-CONFIGURATION
# -----------------------------
# A. Identify Wireless Interfaces & Settings:
#    - The physical Wi-Fi interface is detected automatically from `iw dev`.
#
# B. Configure hostapd (/etc/hostapd/hostapd.conf):
#    - Open or create the file using Vim:
#        doas vim /etc/hostapd/hostapd.conf
#
#    - Paste and save the following template:
#        interface=uap0
#        driver=nl80211
#        ssid=YourHotspotName
#        hw_mode=g
#        channel=6
#        ieee80211n=1
#        wpa=2
#        wpa_passphrase=YourStrongPassword
#        wpa_key_mgmt=WPA-PSK
#        rsn_pairwise=CCMP
#
# C. Configure dnsmasq (/etc/dnsmasq.conf):
#    - Open the configuration file using Vim:
#        doas vim /etc/dnsmasq.conf
#
#    - Append or configure these lines to serve IPs to connected clients:
#        interface=uap0
#        bind-interfaces
#        dhcp-range=192.168.150.10,192.168.150.100,12h
#        dhcp-option=option:router,192.168.150.1
#        dhcp-option=option:dns-server,1.1.1.1,8.8.8.8
#
#
# 3. VARIABLES TO MODIFY IN THIS SCRIPT
# ------------------------------------
#   INTERFACE_AP  : Name of virtual access point interface (e.g., uap0)
#   HOSTAPD_CONF  : Path to hostapd configuration file (/etc/hostapd/hostapd.conf)
#   SUBNET        : Gateway IP for the virtual hotspot network (e.g., 192.168.150.1/24)
#
#
# 4. HOW TO RUN
# -------------
#   Start Hotspot:
#     ./hotspot.sh start
#
#   Stop Hotspot:
#     ./hotspot.sh stop
#
# ==============================================================================

INTERFACE_AP="uap0"
HOSTAPD_CONF="/etc/hostapd/hostapd.conf"
HOSTAPD_RUNTIME_CONF="/run/chezmoi-hotspot-hostapd.conf"
SUBNET="192.168.150.1/24"
if [ -z "${PRIVILEGE_COMMAND:-}" ]; then
    if command -v doas >/dev/null 2>&1; then
        PRIVILEGE_COMMAND=doas
    else
        PRIVILEGE_COMMAND=sudo
    fi
fi

check_privilege_command() {
    if ! command -v "$PRIVILEGE_COMMAND" >/dev/null 2>&1; then
        printf 'hotspot: privilege command not found: %s\n' "$PRIVILEGE_COMMAND" >&2
        return 127
    fi
}

run_privileged() {
    "$PRIVILEGE_COMMAND" "$@"
}

get_phy_interface() {
    iw dev | awk '$1 == "Interface" {interface=$2} $1 == "type" && $2 == "managed" {print interface; exit}'
}

get_uplink_interface() {
    ip route get 1.1.1.1 | awk '{for (i=1; i<=NF; i++) if ($i == "dev") {print $(i+1); exit}}'
}

HOTSPOT_NAT_CHAIN="CFG_HOTSPOT_NAT"
HOTSPOT_FWD_CHAIN="CFG_HOTSPOT_FWD"
IP_FORWARDING_STATE="/run/chezmoi-hotspot-ipv4-forwarding"
HOSTAPD_PID_FILE="/run/chezmoi-hotspot-hostapd.pid"
DNSMASQ_STARTED_STATE="/run/chezmoi-hotspot-started-dnsmasq"
AP_INTERFACE_STATE="/run/chezmoi-hotspot-created-interface"

get_channel() {
    frequency=$(iw dev "$INTERFACE_PHY" link | awk '/freq:/ {print int($2); exit}')

    if [ -z "$frequency" ]; then
        echo 6
    elif [ "$frequency" -ge 2412 ] && [ "$frequency" -le 2484 ]; then
        if [ "$frequency" -eq 2484 ]; then
            echo 14
        else
            echo $(( (frequency - 2407) / 5 ))
        fi
    elif [ "$frequency" -ge 5000 ] && [ "$frequency" -le 5900 ]; then
        echo $(( (frequency - 5000) / 5 ))
    else
        printf 'hotspot: unsupported upstream Wi-Fi frequency: %s MHz\n' "$frequency" >&2
        return 1
    fi
}

start_hotspot() {
    check_privilege_command || exit $?
    echo "Starting Hotspot..."

    INTERFACE_PHY="$(get_phy_interface)"
    INTERFACE_UPLINK="$(get_uplink_interface)"

    if [ -z "$INTERFACE_PHY" ]; then
        echo "Error: no managed wireless interface found."
        exit 1
    fi

    if [ -z "$INTERFACE_UPLINK" ]; then
        echo "Error: no Internet uplink interface found."
        exit 1
    fi

    echo "Using wireless interface: $INTERFACE_PHY"
    echo "Using Internet uplink: $INTERFACE_UPLINK"

    # Dynamically match channel of main interface
    CURR_CHAN=$(get_channel) || exit 1
    echo "Syncing hostapd to Channel $CURR_CHAN..."
    if ! run_privileged grep -Eq '^[[:space:]]*channel=' "$HOSTAPD_CONF"; then
        echo "Error: $HOSTAPD_CONF must contain a channel= setting." >&2
        exit 1
    fi
    if [ "$CURR_CHAN" -gt 14 ] &&
       ! run_privileged grep -Eq '^[[:space:]]*hw_mode=[[:space:]]*a([[:space:]#]|$)' "$HOSTAPD_CONF"; then
        echo "Error: upstream is on 5 GHz, but $HOSTAPD_CONF must set hw_mode=a." >&2
        exit 1
    fi
    if ! run_privileged install -m 0600 -- "$HOSTAPD_CONF" "$HOSTAPD_RUNTIME_CONF" ||
       ! run_privileged sed -i "s/^channel=.*/channel=$CURR_CHAN/" "$HOSTAPD_RUNTIME_CONF"; then
        echo "Error: failed to prepare temporary hostapd configuration." >&2
        run_privileged rm -f -- "$HOSTAPD_RUNTIME_CONF"
        exit 1
    fi

    # Save the prior setting so stop_hotspot can restore it.
    if ! run_privileged test -e "$IP_FORWARDING_STATE"; then
        forwarding_before=$(sysctl -n net.ipv4.ip_forward) || exit 1
        case "$forwarding_before" in
            0|1) ;;
            *) echo "Error: unexpected IPv4 forwarding value: $forwarding_before" >&2; exit 1 ;;
        esac
        printf '%s\n' "$forwarding_before" |
            run_privileged tee "$IP_FORWARDING_STATE" >/dev/null || exit 1
    fi

    # Enable IP forwarding
    if ! run_privileged sysctl -w net.ipv4.ip_forward=1 >/dev/null; then
        echo "Error: failed to enable IPv4 forwarding." >&2
        stop_hotspot
        exit 1
    fi

    # Unblock RFKILL
    run_privileged rfkill unblock wlan 2>/dev/null

    # Remove a stale AP interface only when this script recorded creating it.
    if run_privileged iw dev "$INTERFACE_AP" info >/dev/null 2>&1; then
        if run_privileged test -f "$AP_INTERFACE_STATE"; then
            run_privileged ip link set "$INTERFACE_AP" down 2>/dev/null
            run_privileged iw dev "$INTERFACE_AP" del 2>/dev/null
            run_privileged rm -f -- "$AP_INTERFACE_STATE"
        else
            echo "Error: interface $INTERFACE_AP already exists and is not owned by this script." >&2
            stop_hotspot
            exit 1
        fi
    fi

    # Create virtual AP interface
    if ! run_privileged iw dev "$INTERFACE_PHY" interface add "$INTERFACE_AP" type __ap; then
        echo "Error: failed to create access point interface $INTERFACE_AP." >&2
        stop_hotspot
        exit 1
    fi
    if ! printf '%s\n' created | run_privileged tee "$AP_INTERFACE_STATE" >/dev/null; then
        echo "Error: failed to record ownership of interface $INTERFACE_AP." >&2
        run_privileged iw dev "$INTERFACE_AP" del 2>/dev/null
        stop_hotspot
        exit 1
    fi

    # Bring up the interface
    if ! run_privileged ip link set "$INTERFACE_AP" up ||
       ! run_privileged ip addr flush dev "$INTERFACE_AP" ||
       ! run_privileged ip addr add "$SUBNET" dev "$INTERFACE_AP"; then
        echo "Error: failed to configure access point interface $INTERFACE_AP." >&2
        stop_hotspot
        exit 1
    fi

    # Start hostapd
    if ! run_privileged hostapd -B -P "$HOSTAPD_PID_FILE" "$HOSTAPD_RUNTIME_CONF"; then
        echo "Error: hostapd failed to start."
        stop_hotspot
        exit 1
    fi

    # Apply only the rules owned by this hotspot script.
    cleanup_firewall
    if ! run_privileged iptables -t nat -N "$HOTSPOT_NAT_CHAIN" ||
       ! run_privileged iptables -N "$HOTSPOT_FWD_CHAIN" ||
       ! run_privileged iptables -t nat -A "$HOTSPOT_NAT_CHAIN" -o "$INTERFACE_UPLINK" -j MASQUERADE ||
       ! run_privileged iptables -A "$HOTSPOT_FWD_CHAIN" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT ||
       ! run_privileged iptables -A "$HOTSPOT_FWD_CHAIN" -i "$INTERFACE_AP" -o "$INTERFACE_UPLINK" -j ACCEPT ||
       ! run_privileged iptables -t nat -A POSTROUTING -j "$HOTSPOT_NAT_CHAIN" ||
       ! run_privileged iptables -A FORWARD -j "$HOTSPOT_FWD_CHAIN"; then
        echo "Error: failed to configure hotspot iptables rules." >&2
        stop_hotspot
        exit 1
    fi
    if run_privileged nft list chain inet filter input >/dev/null 2>&1; then
        run_privileged nft add rule inet filter input iifname "$INTERFACE_AP" udp dport 67 accept comment "CFG_HOTSPOT_DHCP" || {
            echo "Error: failed to add the hotspot DHCP firewall rule." >&2
            stop_hotspot
            exit 1
        }
    fi
    if run_privileged nft list chain inet filter forward >/dev/null 2>&1; then
        run_privileged nft add rule inet filter forward iifname "$INTERFACE_AP" oifname "$INTERFACE_UPLINK" accept comment "CFG_HOTSPOT_FWD" || {
            echo "Error: failed to add the hotspot forwarding firewall rule." >&2
            stop_hotspot
            exit 1
        }
        run_privileged nft add rule inet filter forward iifname "$INTERFACE_UPLINK" oifname "$INTERFACE_AP" ct state established,related accept comment "CFG_HOTSPOT_FWD" || {
            echo "Error: failed to add the hotspot return-traffic firewall rule." >&2
            stop_hotspot
            exit 1
        }
    fi

    # Start dnsmasq only if it was not already active, and remember ownership.
    if ! run_privileged systemctl is-active --quiet dnsmasq; then
        printf '%s\n' started |
            run_privileged tee "$DNSMASQ_STARTED_STATE" >/dev/null || exit 1
        if ! run_privileged systemctl start dnsmasq; then
            echo "Error: dnsmasq failed to start." >&2
            stop_hotspot
            exit 1
        fi
    fi
    echo "Hotspot started successfully on Channel $CURR_CHAN."
}

cleanup_firewall() {
    run_privileged iptables -t nat -D POSTROUTING -j "$HOTSPOT_NAT_CHAIN" 2>/dev/null || true
    run_privileged iptables -D FORWARD -j "$HOTSPOT_FWD_CHAIN" 2>/dev/null || true
    run_privileged iptables -t nat -F "$HOTSPOT_NAT_CHAIN" 2>/dev/null || true
    run_privileged iptables -F "$HOTSPOT_FWD_CHAIN" 2>/dev/null || true
    run_privileged iptables -t nat -X "$HOTSPOT_NAT_CHAIN" 2>/dev/null || true
    run_privileged iptables -X "$HOTSPOT_FWD_CHAIN" 2>/dev/null || true
    for handle in $(run_privileged nft -a list chain inet filter input 2>/dev/null | awk '/comment "CFG_HOTSPOT_DHCP"/ {print $NF}'); do
        run_privileged nft delete rule inet filter input handle "$handle"
    done
    for handle in $(run_privileged nft -a list chain inet filter forward 2>/dev/null | awk '/comment "CFG_HOTSPOT_FWD"/ {print $NF}'); do
        run_privileged nft delete rule inet filter forward handle "$handle"
    done
}

stop_hotspot() {
    check_privilege_command || exit $?
    echo "Stopping Hotspot..."
    if run_privileged test -f "$HOSTAPD_PID_FILE"; then
        hostapd_pid=$(run_privileged cat "$HOSTAPD_PID_FILE")
        case "$hostapd_pid" in
            ''|*[!0-9]*)
                printf 'hotspot: invalid PID in %s; leaving it for inspection.\n' \
                    "$HOSTAPD_PID_FILE" >&2
                ;;
            *)
                if [ "$(run_privileged cat "/proc/$hostapd_pid/comm" 2>/dev/null)" = hostapd ]; then
                    run_privileged kill "$hostapd_pid"
                fi
                run_privileged rm -f -- "$HOSTAPD_PID_FILE"
                ;;
        esac
    fi
    run_privileged rm -f -- "$HOSTAPD_RUNTIME_CONF"
    if run_privileged test -f "$AP_INTERFACE_STATE"; then
        run_privileged ip link set "$INTERFACE_AP" down 2>/dev/null
        if run_privileged iw dev "$INTERFACE_AP" del 2>/dev/null; then
            run_privileged rm -f -- "$AP_INTERFACE_STATE"
        fi
    fi
    if run_privileged test -f "$DNSMASQ_STARTED_STATE"; then
        if run_privileged systemctl stop dnsmasq; then
            run_privileged rm -f -- "$DNSMASQ_STARTED_STATE"
        fi
    fi
    cleanup_firewall
    if run_privileged test -f "$IP_FORWARDING_STATE"; then
        forwarding_before=$(run_privileged cat "$IP_FORWARDING_STATE")
        case "$forwarding_before" in
            0|1)
                run_privileged sysctl -w "net.ipv4.ip_forward=$forwarding_before" >/dev/null &&
                    run_privileged rm -f -- "$IP_FORWARDING_STATE"
                ;;
            *)
                printf 'hotspot: invalid saved forwarding value in %s; leaving it for inspection.\n' \
                    "$IP_FORWARDING_STATE" >&2
                ;;
        esac
    fi
    echo "Hotspot stopped."
}

case "$1" in
    start)
        start_hotspot
        ;;
    stop)
        stop_hotspot
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
