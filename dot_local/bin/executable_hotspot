#!/bin/sh

# ==============================================================================
# Script Name   : hotspot.sh
# Author        : Abdullah Khabir <https://abdullah.support>
# Description   : Automates creating a Wi-Fi Access Point (Hotspot) on Arch Linux
#                 sharing internet from a single wireless interface via NAT.
#                 Automatically syncs AP radio channel with upstream Wi-Fi.
# ==============================================================================
#
# 1. DEPENDENCIES
# ---------------
# Ensure the following packages are installed on your Arch Linux system:
#
#   doas pacman -S hostapd dnsmasq iptables nftables iproute2 iw rfkill
#
#
# 2. REQUIRED PRE-CONFIGURATION
# -----------------------------
# A. Identify Wireless Interfaces & Settings:
#    - The physical Wi-Fi interface is detected automatically from `iw dev`.
#
# B. Configure hostapd (/etc/hostapd/hostapd.conf):
#    - Open or create the file using Vim:
#        doas vim /etc/hostapd/hostapd.conf
#
#    - Paste and save the following template:
#        interface=uap0
#        driver=nl80211
#        ssid=YourHotspotName
#        hw_mode=g
#        channel=6
#        ieee80211n=1
#        wpa=2
#        wpa_passphrase=YourStrongPassword
#        wpa_key_mgmt=WPA-PSK
#        rsn_pairwise=CCMP
#
# C. Configure dnsmasq (/etc/dnsmasq.conf):
#    - Open the configuration file using Vim:
#        doas vim /etc/dnsmasq.conf
#
#    - Append or configure these lines to serve IPs to connected clients:
#        interface=uap0
#        bind-interfaces
#        dhcp-range=192.168.150.10,192.168.150.100,12h
#        dhcp-option=option:router,192.168.150.1
#        dhcp-option=option:dns-server,1.1.1.1,8.8.8.8
#
#
# 3. VARIABLES TO MODIFY IN THIS SCRIPT
# ------------------------------------
#   INTERFACE_AP  : Name of virtual access point interface (e.g., uap0)
#   HOSTAPD_CONF  : Path to hostapd configuration file (/etc/hostapd/hostapd.conf)
#   SUBNET        : Gateway IP for the virtual hotspot network (e.g., 192.168.150.1/24)
#
#
# 4. HOW TO RUN
# -------------
#   Start Hotspot:
#     ./hotspot.sh start
#
#   Stop Hotspot:
#     ./hotspot.sh stop
#
# ==============================================================================

INTERFACE_AP="uap0"
HOSTAPD_CONF="/etc/hostapd/hostapd.conf"
SUBNET="192.168.150.1/24"
PRIVILEGE_COMMAND="${PRIVILEGE_COMMAND:-doas}"

check_privilege_command() {
    if ! command -v "$PRIVILEGE_COMMAND" >/dev/null 2>&1; then
        printf 'hotspot: privilege command not found: %s\n' "$PRIVILEGE_COMMAND" >&2
        return 127
    fi
}

run_privileged() {
    "$PRIVILEGE_COMMAND" "$@"
}

get_phy_interface() {
    iw dev | awk '$1 == "Interface" {interface=$2} $1 == "type" && $2 == "managed" {print interface; exit}'
}

get_uplink_interface() {
    ip route get 1.1.1.1 | awk '{for (i=1; i<=NF; i++) if ($i == "dev") {print $(i+1); exit}}'
}

HOTSPOT_NAT_CHAIN="CFG_HOTSPOT_NAT"
HOTSPOT_FWD_CHAIN="CFG_HOTSPOT_FWD"

get_channel() {
    # Extract frequency from iw link and map to 2.4GHz channel
    FREQ=$(iw dev "$INTERFACE_PHY" link | awk '/freq:/ {print $2}' | cut -d. -f1)
    if [ -n "$FREQ" ]; then
        # Channel calculation for 2.4GHz (2412MHz = Ch 1)
        CHANNEL=$(( (FREQ - 2407) / 5 ))
        echo "$CHANNEL"
    else
        # Default fallback channel if not connected
        echo "6"
    fi
}

start_hotspot() {
    check_privilege_command || exit $?
    echo "Starting Hotspot..."

    INTERFACE_PHY="$(get_phy_interface)"
    INTERFACE_UPLINK="$(get_uplink_interface)"

    if [ -z "$INTERFACE_PHY" ]; then
        echo "Error: no managed wireless interface found."
        exit 1
    fi

    if [ -z "$INTERFACE_UPLINK" ]; then
        echo "Error: no Internet uplink interface found."
        exit 1
    fi

    echo "Using wireless interface: $INTERFACE_PHY"
    echo "Using Internet uplink: $INTERFACE_UPLINK"

    # Dynamically match channel of main interface
    CURR_CHAN=$(get_channel)
    echo "Syncing hostapd to Channel $CURR_CHAN..."
    run_privileged sed -i "s/^channel=.*/channel=$CURR_CHAN/" "$HOSTAPD_CONF"

    # Enable IP forwarding
    run_privileged sysctl -w net.ipv4.ip_forward=1 >/dev/null

    # Unblock RFKILL
    run_privileged rfkill unblock wlan 2>/dev/null

    # Cleanup old interface if present
    run_privileged ip link set "$INTERFACE_AP" down 2>/dev/null
    run_privileged iw dev "$INTERFACE_AP" del 2>/dev/null

    # Create virtual AP interface
    run_privileged iw dev "$INTERFACE_PHY" interface add "$INTERFACE_AP" type __ap

    # Bring up the interface
    run_privileged ip link set "$INTERFACE_AP" up

    # Assign IP address
    run_privileged ip addr flush dev "$INTERFACE_AP"
    run_privileged ip addr add "$SUBNET" dev "$INTERFACE_AP"

    # Start hostapd
    if ! run_privileged hostapd -B "$HOSTAPD_CONF"; then
        echo "Error: hostapd failed to start."
        stop_hotspot
        exit 1
    fi

    # Apply only the rules owned by this hotspot script.
    cleanup_firewall
    run_privileged iptables -t nat -N "$HOTSPOT_NAT_CHAIN"
    run_privileged iptables -N "$HOTSPOT_FWD_CHAIN"
    run_privileged iptables -t nat -A "$HOTSPOT_NAT_CHAIN" -o "$INTERFACE_UPLINK" -j MASQUERADE
    run_privileged iptables -A "$HOTSPOT_FWD_CHAIN" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
    run_privileged iptables -A "$HOTSPOT_FWD_CHAIN" -i "$INTERFACE_AP" -o "$INTERFACE_UPLINK" -j ACCEPT
    run_privileged iptables -t nat -A POSTROUTING -j "$HOTSPOT_NAT_CHAIN"
    run_privileged iptables -A FORWARD -j "$HOTSPOT_FWD_CHAIN"
    run_privileged nft add rule inet filter input iifname "$INTERFACE_AP" udp dport 67 accept comment "CFG_HOTSPOT_DHCP"
    run_privileged nft add rule inet filter forward iifname "$INTERFACE_AP" oifname "$INTERFACE_UPLINK" accept comment "CFG_HOTSPOT_FWD"
    run_privileged nft add rule inet filter forward iifname "$INTERFACE_UPLINK" oifname "$INTERFACE_AP" ct state established,related accept comment "CFG_HOTSPOT_FWD"

    # Restart DHCP/DNS server
    run_privileged systemctl restart dnsmasq
    echo "Hotspot started successfully on Channel $CURR_CHAN."
}

cleanup_firewall() {
    run_privileged iptables -t nat -D POSTROUTING -j "$HOTSPOT_NAT_CHAIN" 2>/dev/null || true
    run_privileged iptables -D FORWARD -j "$HOTSPOT_FWD_CHAIN" 2>/dev/null || true
    run_privileged iptables -t nat -F "$HOTSPOT_NAT_CHAIN" 2>/dev/null || true
    run_privileged iptables -F "$HOTSPOT_FWD_CHAIN" 2>/dev/null || true
    run_privileged iptables -t nat -X "$HOTSPOT_NAT_CHAIN" 2>/dev/null || true
    run_privileged iptables -X "$HOTSPOT_FWD_CHAIN" 2>/dev/null || true
    for handle in $(run_privileged nft -a list chain inet filter input | awk '/comment "CFG_HOTSPOT_DHCP"/ {print $NF}'); do
        run_privileged nft delete rule inet filter input handle "$handle"
    done
    for handle in $(run_privileged nft -a list chain inet filter forward | awk '/comment "CFG_HOTSPOT_FWD"/ {print $NF}'); do
        run_privileged nft delete rule inet filter forward handle "$handle"
    done
}

stop_hotspot() {
    check_privilege_command || exit $?
    echo "Stopping Hotspot..."
    run_privileged killall hostapd 2>/dev/null
    run_privileged ip link set "$INTERFACE_AP" down 2>/dev/null
    run_privileged iw dev "$INTERFACE_AP" del 2>/dev/null
    run_privileged systemctl stop dnsmasq 2>/dev/null
    cleanup_firewall
    echo "Hotspot stopped."
}

case "$1" in
    start)
        start_hotspot
        ;;
    stop)
        stop_hotspot
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
