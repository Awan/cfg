#!/usr/bin/env bash
set -euo pipefail

# GitHub repository details
GITHUB_REPO_OWNER="awan"
GITHUB_REPO_NAME="man"
FILE_PATH="data"

# Personal Access Token (PAT)
GITHUB_TOKEN="$(passage github/tokens/man-app_repo_full_access)" || {
  printf '%s\n' 'Error: unable to read the GitHub token from passage.' >&2
  exit 1
}

if [[ -z "$GITHUB_TOKEN" ]]; then
  printf '%s\n' 'Error: the GitHub token is empty.' >&2
  exit 1
fi

BASE_URL="https://api.github.com/repos/$GITHUB_REPO_OWNER/$GITHUB_REPO_NAME/contents/$FILE_PATH"

# Keep the token out of curl's command-line arguments. The temporary config is
# private to this user and removed when the script exits.
umask 077
CURL_CONFIG="$(mktemp)"
trap 'rm -f -- "$CURL_CONFIG"' EXIT
printf 'header = "Authorization: token %s"\n' "$GITHUB_TOKEN" > "$CURL_CONFIG"
unset GITHUB_TOKEN

curl_api() {
  curl --config "$CURL_CONFIG" --fail --silent --show-error \
    --connect-timeout 5 --max-time 20 \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    "$@"
}

update_file() {
  local commit_message="$1"
  local new_content="$2"
  local current_response current_sha current_content encoded_content update_payload

  current_response="$(curl_api "$BASE_URL")"
  current_sha="$(printf '%s' "$current_response" | jq -er '.sha')"
  current_content="$(printf '%s' "$current_response" | jq -er '.content' | base64 -d)"

  if [[ "$new_content" != "$current_content" ]]; then
    encoded_content="$(printf '%s' "$new_content" | base64 | tr -d '\n')"
    update_payload="$(jq -n \
      --arg message "$commit_message" \
      --arg content "$encoded_content" \
      --arg sha "$current_sha" \
      '{message: $message, content: $content, sha: $sha}')"

    curl_api --request PUT \
      -H 'Content-Type: application/json' \
      --data "$update_payload" \
      "$BASE_URL" >/dev/null
    printf '%s\n' "$new_content"
  else
    printf 'Output is the same: %s\n' "$new_content"
  fi
}

# Run the data generator and update the remote file only when its content
# differs from the current GitHub version.
script_output="$("$HOME/.local/bin/man.py")"
update_file "Update data file" "$script_output"
