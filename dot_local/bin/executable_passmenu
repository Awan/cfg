#!/usr/bin/env bash

shopt -s nullglob globstar

typeit=0
if [[ $1 == "--type" ]]; then
	typeit=1
	shift
fi


BASEDIR="${PASSAGE_DIR:-${PASSWORD_STORE_DIR:-$HOME/.passage/store}}"
while [[ "$BASEDIR" != "/" && "$BASEDIR" == */ ]]; do
  BASEDIR="${BASEDIR%/}"
done
STARTDIR="$BASEDIR"

if [[ ! -d "$BASEDIR" ]]; then
  printf 'passmenu: password store not found: %s\n' "$BASEDIR" >&2
  exit 1
fi
DONE=0
LEVEL=0
PREVSELECTION=""
SELECTION=""

while [ "$DONE" -eq 0 ] ; do 
  password_files=( "$STARTDIR"/* )
  password_files=( "${password_files[@]#"$STARTDIR"/}" )
  password_files=( "${password_files[@]%.age}" )
  
  if [ "$LEVEL" -ne 0 ] ; then
    password_files=( ".." "${password_files[@]}") 
  fi
  entry=$(printf '%s\n' "${password_files[@]}" | dmenu "$@" -l 15)
  
  if [ -z "$entry" ] ; then
    DONE=1
    exit
  fi
  
  if [ "$entry" != ".." ] ; then
    PREVSELECTION=$SELECTION
    if [[ -n "$SELECTION" ]]; then
      SELECTION="$SELECTION/$entry"
    else
      SELECTION="$entry"
    fi
  
    # check if another dir
    if [ -d "$STARTDIR/$entry" ] ; then
      STARTDIR="$STARTDIR/$entry"
      LEVEL=$((LEVEL+1))
    else
      # not a directory so it must be a real password entry
  
      if [[ $typeit -eq 0 ]]; then
        passage show -c "$SELECTION" 2>/dev/null
      else
        # Pass the password as one argument instead of feeding it to
        # xdotool's command parser, where special characters could be
        # interpreted as additional xdotool commands.
        password=$(passage show "$SELECTION") || {
          printf 'passmenu: failed to read password entry: %s\n' "$SELECTION" >&2
          exit 1
        }
        password="${password%%$'\n'*}"
        xdotool type --clearmodifiers -- "$password"
      fi
      DONE=1
    fi
  
  else
    LEVEL=$((LEVEL-1))
    SELECTION=$PREVSELECTION
    STARTDIR="$BASEDIR"
    if [[ -n "$SELECTION" ]]; then
      STARTDIR="$STARTDIR/$SELECTION"
    fi
  fi
done

