#!/usr/bin/env bash

# Resize the focused window to one-third of the screen and place it bottom-left.

if ! command -v xdotool >/dev/null 2>&1; then
  printf '%s\n' 'bottomleft: xdotool is required.' >&2
  exit 127
fi

window_id="$(xdotool getwindowfocus)" || exit 1
if [[ -z "$window_id" ]]; then
  printf '%s\n' 'bottomleft: no focused window found.' >&2
  exit 1
fi

read -r screen_width screen_height < <(xdotool getdisplaygeometry) || exit 1
if [[ ! "$screen_width" =~ ^[0-9]+$ || ! "$screen_height" =~ ^[0-9]+$ ]] ||
   (( screen_width == 0 || screen_height == 0 )); then
  printf '%s\n' 'bottomleft: invalid screen geometry.' >&2
  exit 1
fi

window_width=$((screen_width / 3))
window_height=$((screen_height / 3))

xdotool windowsize "$window_id" "$window_width" "$window_height" || exit 1

# Query actual size in case the window manager enforces minimum dimensions.
actual_height="$(xdotool getwindowgeometry --shell "$window_id" |
  awk -F= '$1 == "HEIGHT" { print $2; exit }')"
if [[ ! "$actual_height" =~ ^[0-9]+$ ]]; then
  printf '%s\n' 'bottomleft: could not determine the resized window height.' >&2
  exit 1
fi

y_position=$((screen_height - actual_height))
xdotool windowmove "$window_id" 0 "$y_position"
