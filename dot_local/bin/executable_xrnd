#!/usr/bin/env bash
# Create and apply a custom XRandR mode from WIDTH HEIGHT REFRESH_RATE.
# Accept either three arguments or one quoted, space-separated argument.
# The primary connected output is preferred; otherwise the first connected
# output is used.

usage() {
  printf 'Usage: %s WIDTH HEIGHT REFRESH_RATE\n' "${0##*/}" >&2
  printf '   or: %s "WIDTH HEIGHT REFRESH_RATE"\n' "${0##*/}" >&2
}

if (( $# == 1 )); then
  read -r -a params <<< "$1"
else
  params=("$@")
fi

if (( ${#params[@]} != 3 )); then
  usage
  exit 2
fi

width="${params[0]}"
height="${params[1]}"
rate="${params[2]}"

for value in "$width" "$height" "$rate"; do
  if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value == 0 )); then
    printf 'xrnd: dimensions and refresh rate must be positive integers.\n' >&2
    usage
    exit 2
  fi
done

for dependency in xrandr gtf; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    printf 'xrnd: required command not found: %s\n' "$dependency" >&2
    exit 127
  fi
done

display="$(xrandr --query | awk '
  $2 == "connected" {
    if ($3 == "primary") primary = $1
    if (first == "") first = $1
  }
  END { print primary != "" ? primary : first }
')"

if [[ -z "$display" ]]; then
  printf '%s\n' 'xrnd: no connected display was found.' >&2
  exit 1
fi

modename="${width}_${height}_${rate}"
modeline="$(gtf "$width" "$height" "$rate" 2>/dev/null |
  awk '/Modeline/ {
    sub(/^[[:space:]]*Modeline[[:space:]]+"[^"]+"[[:space:]]*/, "")
    print
    exit
  }')"

if [[ -z "$modeline" ]]; then
  printf 'xrnd: gtf could not generate a mode for %s x %s at %s Hz.\n' "$width" "$height" "$rate" >&2
  exit 1
fi

read -r -a modeline_args <<< "$modeline"

mode_exists() {
  xrandr --query | awk -v wanted="$1" '
    $1 == wanted { found = 1 }
    END { exit !found }
  '
}

mode_available_on_display() {
  xrandr --query | awk -v output="$1" -v wanted="$2" '
    /^[^[:space:]]+ connected/ {
      active = ($1 == output)
      next
    }
    active && $1 == wanted { found = 1 }
    END { exit !found }
  '
}

if ! mode_exists "$modename"; then
  if ! xrandr --newmode "$modename" "${modeline_args[@]}"; then
    printf 'xrnd: could not register mode %s.\n' "$modename" >&2
    exit 1
  fi
fi

if ! mode_available_on_display "$display" "$modename"; then
  if ! xrandr --addmode "$display" "$modename"; then
    printf 'xrnd: could not add mode %s to display %s.\n' "$modename" "$display" >&2
    exit 1
  fi
fi

if xrandr --output "$display" --mode "$modename"; then
  printf 'Display %s changed to %s x %s at %s Hz.\n' "$display" "$width" "$height" "$rate"
else
  printf 'xrnd: could not apply mode %s to display %s.\n' "$modename" "$display" >&2
  exit 1
fi
