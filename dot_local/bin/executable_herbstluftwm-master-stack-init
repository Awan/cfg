#!/bin/sh
set -eu

hc() {
    herbstclient "$@"
}

initialize_tag() {
    winid=$1
    case "$winid" in
        0x*) ;;
        *) return 0 ;;
    esac
    case "${winid#0x}" in
        ''|*[!0-9a-fA-F]*) return 0 ;;
    esac

    tag=$(hc get_attr "clients.$winid.tag" 2>/dev/null) || return 0
    case "$tag" in
        ''|*[!A-Za-z0-9_.-]*) return 0 ;;
    esac

    floating=$(hc get_attr "clients.$winid.floating" 2>/dev/null) || return 0
    [ "$floating" = false ] || return 0

    frame_count=$(hc get_attr "tags.by-name.$tag.frame_count" 2>/dev/null) || return 0
    client_count=$(hc get_attr "tags.by-name.$tag.tiling.root.client_count" 2>/dev/null) || return 0
    [ "$frame_count" = 1 ] && [ "$client_count" = 1 ] || return 0

    layout=$(hc dump "$tag") || return 0
    case "$layout" in
        "(clients vertical:"*"$winid"*) ;;
        *) return 0 ;;
    esac

    if ! hc load "$tag" "(split horizontal:0.5:1 (clients vertical:0 $winid) (clients vertical:0))"; then
        printf 'herbstluftwm-master-stack-init: failed to initialize tag %s\n' "$tag" >&2
        return 1
    fi
}

herbstclient --idle | while read -r event rule_name winid; do
    case "$event" in
        reload)
            exit 0
            ;;
        rule)
            [ "$rule_name" = master-stack-init ] || continue
            initialize_tag "$winid"
            ;;
    esac
done
