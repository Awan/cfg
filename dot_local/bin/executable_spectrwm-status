#!/bin/sh

mail_count() {
    count=0
    for mail in "$HOME"/.local/share/email/x1c/INBOX/new/*; do
        [ -f "$mail" ] && count=$((count + 1))
    done
    printf '%s' "$count"
}

read_hardware_status() {
    battery='?'
    battery_icon='󰁹'
    battery_color=8
    battery_state=

    for battery_dir in /sys/class/power_supply/*; do
        [ -r "$battery_dir/type" ] || continue
        IFS= read -r battery_type < "$battery_dir/type"
        [ "$battery_type" = Battery ] || continue
        [ -r "$battery_dir/capacity" ] || continue

        IFS= read -r battery_level < "$battery_dir/capacity"
        case "$battery_level" in
            ''|*[!0-9]*) continue ;;
        esac

        battery="${battery_level}%"
        if [ -r "$battery_dir/status" ]; then
            IFS= read -r battery_state < "$battery_dir/status"
        fi

        if [ "$battery_level" -le 15 ]; then
            battery_color=1
            battery_icon='󰂃'
        elif [ "$battery_level" -le 35 ]; then
            battery_icon='󰂂'
        elif [ "$battery_level" -le 60 ]; then
            battery_icon='󰂀'
        elif [ "$battery_level" -le 85 ]; then
            battery_icon='󰁼'
        else
            battery_icon='󰁹'
        fi

        if [ "$battery_state" = Charging ]; then
            battery_color=3
        fi
        break
    done

    temperature='?'
    temperature_color=9
    thermal_zone=

    for thermal_type in /sys/class/thermal/thermal_zone*/type; do
        [ -r "$thermal_type" ] || continue
        IFS= read -r zone_type < "$thermal_type"
        case "$zone_type" in
            *cpu*|*CPU*|*pkg*|*Package*|*package*)
                thermal_zone=${thermal_type%/type}
                break
                ;;
        esac
        [ -n "$thermal_zone" ] || thermal_zone=${thermal_type%/type}
    done

    if [ -n "$thermal_zone" ] && [ -r "$thermal_zone/temp" ]; then
        IFS= read -r temperature_raw < "$thermal_zone/temp"
        case "$temperature_raw" in
            ''|*[!0-9]*) temperature='?' ;;
            *)
                temperature=$((temperature_raw / 1000))
                [ "$temperature" -ge 80 ] && temperature_color=1
                ;;
        esac
    fi
}

read_cpu() {
    read -r _ user nice system idle iowait irq softirq steal rest < /proc/stat
    cpu_total=$((user + nice + system + idle + iowait + irq + softirq + steal))
    cpu_idle=$((idle + iowait))
}

read_memory() {
    mem_total=0
    mem_available=0

    while read -r key value rest; do
        case "$key" in
            MemTotal:) mem_total=$value ;;
            MemAvailable:) mem_available=$value ;;
        esac
    done < /proc/meminfo

    if [ "$mem_total" -gt 0 ]; then
        ram=$(((mem_total - mem_available) * 100 / mem_total))
    else
        ram=0
    fi
}

read_output_icon() {
    volume_icon=''
    default_sink=$(pactl get-default-sink 2>/dev/null) || return

    case "$default_sink" in
        *bluez*|*bluetooth*)
            volume_icon=''
            ;;
        *)
            active_port=$(
                pactl list sinks 2>/dev/null |
                    awk -v sink="$default_sink" '
                        /^Sink #[0-9]/ { in_sink = 0 }
                        /^[[:space:]]+Name: / { in_sink = ($2 == sink) }
                        in_sink && /^[[:space:]]+Active Port: / {
                            print $3
                            exit
                        }
                    '
            )
            case "$active_port" in
                *headphone*|*headset*) volume_icon='' ;;
            esac
            ;;
    esac
}

music_metadata_separator=$(printf '\034')
music_metadata_format=$(printf '%%artist%%%s%%title%%' "$music_metadata_separator")
wifi_refresh=0
hardware_refresh=0
audio_refresh=0
music_status=
music_artist=
music_title=
music_key=
wifi=
wifi_connected=0
volume_icon=''

while :; do
    read_cpu

    if [ -n "${prev_total:-}" ]; then
        delta_total=$((cpu_total - prev_total))
        delta_idle=$((cpu_idle - prev_idle))

        if [ "$delta_total" -gt 0 ]; then
            cpu_usage=$(((delta_total - delta_idle) * 100 / delta_total))
        else
            cpu_usage=0
        fi
    else
        cpu_usage=0
    fi

    prev_total=$cpu_total
    prev_idle=$cpu_idle

    read_memory

    brightness_pct='?'
    for brightness_dir in "${BACKLIGHT_SYSFS_DIR:-/sys/class/backlight}"/*; do
        [ -r "$brightness_dir/brightness" ] &&
            [ -r "$brightness_dir/max_brightness" ] || continue
        IFS= read -r brightness < "$brightness_dir/brightness"
        IFS= read -r max_brightness < "$brightness_dir/max_brightness"
        case "$brightness" in ''|*[!0-9]*) continue ;; esac
        case "$max_brightness" in ''|*[!0-9]*) continue ;; esac

        if [ "$max_brightness" -gt 0 ]; then
            brightness_pct=$(((brightness * 100 + max_brightness / 2) / max_brightness))
            break
        fi
    done

    if [ "$wifi_refresh" -le 0 ]; then
        wifi_interface=
        wifi=
        wifi_connected=0
        for network_device in /sys/class/net/*; do
            if [ -d "$network_device/wireless" ]; then
                wifi_interface=${network_device##*/}
                break
            fi
        done

        if [ -n "$wifi_interface" ]; then
            wifi_info=$(iw dev "$wifi_interface" link 2>/dev/null)
            case "$wifi_info" in
                *"Connected to "*)
                    wifi_connected=1
                    wifi_ssid=
                    while IFS= read -r wifi_line; do
                        case "$wifi_line" in
                            *"SSID: "*) wifi_ssid=${wifi_line#*SSID: }; break ;;
                        esac
                    done <<EOF
$wifi_info
EOF
                    while [ "${#wifi_ssid}" -gt 16 ]; do
                        wifi_ssid=${wifi_ssid%?}
                    done
                    wifi=$wifi_ssid
                    ;;
            esac
        fi
        wifi_refresh=4
    else
        wifi_refresh=$((wifi_refresh - 1))
    fi

    volume_info=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    if [ "$audio_refresh" -le 0 ]; then
        read_output_icon
        audio_refresh=4
    else
        audio_refresh=$((audio_refresh - 1))
    fi
    case "$volume_info" in
        *"[MUTED]"*)
            volume=MUTE
            volume_icon=''
            ;;
        "Volume: "*)
            volume=${volume_info#Volume: }
            volume=${volume%% *}

            case "$volume" in
                *.*)
                    volume_whole=${volume%%.*}
                    volume_frac=${volume#*.}
                    volume_frac=${volume_frac}00
                    volume_frac=${volume_frac%"${volume_frac#??}"}

                    while [ "${volume_frac#0}" != "$volume_frac" ]; do
                        volume_frac=${volume_frac#0}
                    done

                    [ -n "$volume_frac" ] || volume_frac=0
                    volume=$((volume_whole * 100 + volume_frac))
                    ;;
                *)
                    volume=$((volume * 100))
                    ;;
            esac

            volume=${volume}%
            ;;
        *)
            volume='?'
            ;;
    esac

    mail=$(mail_count)

    if [ "$hardware_refresh" -le 0 ]; then
        read_hardware_status
        hardware_refresh=4
    else
        hardware_refresh=$((hardware_refresh - 1))
    fi

    mpd_state=$(mpc status 2>/dev/null)
    mpd_track_line=
    mpd_status_line=
    {
        IFS= read -r mpd_track_line
        IFS= read -r mpd_status_line
    } <<EOF
$mpd_state
EOF
    IFS=' ' read -r mpd_position _ music_time _ <<EOF
$mpd_status_line
EOF
    music_key=$mpd_track_line:$mpd_position
    music_elapsed=${music_time%%/*}
    case "$music_elapsed" in
        [0-9]:[0-9][0-9]) music_elapsed="0$music_elapsed" ;;
    esac

    case "$mpd_state" in
        *"[playing]"*)
            if [ "$music_key" != "$previous_music_key" ]; then
                music_metadata=$(mpc --format="$music_metadata_format" current 2>/dev/null)
                case "$music_metadata" in
                    *"$music_metadata_separator"*)
                        music_artist=${music_metadata%%"$music_metadata_separator"*}
                        music_title=${music_metadata#*"$music_metadata_separator"}
                        ;;
                    *)
                        music_artist=$music_metadata
                        music_title=
                        ;;
                esac
            fi
            previous_music_key=$music_key
            ;;
        *) music_artist=; music_title=; previous_music_key= ;;
    esac

    music_status=
    case "$mpd_state" in
        *"[playing]"*)
            if [ -n "$music_artist$music_title" ]; then
                display_title=$music_title
                if [ "${#display_title}" -gt 24 ]; then
                    while [ "${#display_title}" -gt 23 ]; do
                        display_title=${display_title%?}
                    done
                    display_title="${display_title}…"
                fi

                music_status="  +@fg=6; +@fg=10;$music_artist"
                [ -n "$display_title" ] &&
                    music_status="$music_status - +@fg=2;$display_title"
                if [ -n "$music_elapsed" ]; then
                    music_status="$music_status +@fg=4;$music_elapsed"
                fi
                music_status="$music_status+@fg=0;"
            fi
            ;;
    esac

    battery_status=
    case "$battery" in
        '?') battery_status= ;;
        *)
            battery_status="  +@fg=$battery_color;$battery_icon $battery+@fg=0;"
            [ "$battery_state" = Charging ] &&
                battery_status="  +@fg=$battery_color; $battery+@fg=0;"
            ;;
    esac

    temperature_status=
    case "$temperature" in
        '?') temperature_status= ;;
        *) temperature_status="  +@fg=$temperature_color; ${temperature}°C+@fg=0;" ;;
    esac

    mail_status=
    if [ "$mail" -gt 0 ]; then
        mail_status="  +@fg=1; $mail+@fg=0;"
    fi

    wifi_status=
    if [ "$wifi_connected" -eq 1 ]; then
        wifi_status="  +@fg=2;${wifi:+ $wifi}+@fg=0;"
    fi

    printf '%s%s%s' "$mail_status" "$music_status" "$wifi_status"

    printf '  +@fg=3;%s %s+@fg=0;  +@fg=4; %s%%+@fg=0;  +@fg=7; %s%%+@fg=0;  +@fg=5; %s%%+@fg=0;%s%s' \
        "$volume_icon" "$volume" "$cpu_usage" "$brightness_pct" "$ram" \
        "$battery_status" "$temperature_status"

    printf '\n'

    sleep 1
done
