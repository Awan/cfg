#!/usr/bin/env bash
#  ▓▓▓▓▓▓▓▓▓▓
# ░▓ Author ▓ Abdullah Khabir <https://abdullah.support/>
# ░▓▓▓▓▓▓▓▓▓▓
# ░░░░░░░░░░

# Show the camera as a small, borderless overlay at the lower-right corner.
camera_device=${WEBCAM_DEVICE:-/dev/video0}

if ! command -v mpv >/dev/null 2>&1; then
    printf '%s\n' 'webcam: mpv is not installed.' >&2
    exit 127
fi
if [ ! -e "$camera_device" ]; then
    printf 'webcam: camera device not found: %s\n' "$camera_device" >&2
    exit 1
fi

mpv "$camera_device" --geometry=-10-10 --autofit=30% --no-osc \
    --no-border --ontop --title=webcam --no-input-default-bindings \
    --input-conf=/dev/null --no-resume-playback --really-quiet &
