#!/usr/bin/env bash
# In the name of Allah, the Most Gracious, the Most Merciful.
# Suspend until TIME, then play SOUND (or the default alarm audio).
# Usage: alarm TIME [SOUND]
#        alarm stop

usage() {
  printf 'Usage: %s TIME [SOUND]\n       %s stop\n' "${0##*/}" "${0##*/}" >&2
  printf 'Example: %s "tomorrow 07:00" "$HOME/Music/alarm.mp3"\n' "${0##*/}" >&2
}

get_privilege_command() {
  if [[ -n "${PRIVILEGE_COMMAND:-}" ]]; then
    if command -v "$PRIVILEGE_COMMAND" >/dev/null 2>&1; then
      printf '%s\n' "$PRIVILEGE_COMMAND"
    else
      printf 'alarm: privilege command not found: %s\n' "$PRIVILEGE_COMMAND" >&2
      return 127
    fi
  elif command -v doas >/dev/null 2>&1; then
    printf '%s\n' doas
  elif command -v sudo >/dev/null 2>&1; then
    printf '%s\n' sudo
  else
    printf '%s\n' 'alarm: neither doas nor sudo is installed.' >&2
    return 127
  fi
}

if [[ "${1:-}" == stop ]]; then
  if (( $# != 1 )); then
    usage
    exit 2
  fi
  privilege_command=$(get_privilege_command) || exit $?
  "$privilege_command" rtcwake -d rtc0 -m disable
  exit $?
fi

if (( $# < 1 || $# > 2 )); then
  usage
  exit 2
fi

alarm_time="$1"
alarm_sound="${2:-$HOME/.local/share/misc/Kursi.mp3}"

if [[ ! -r "$alarm_sound" ]]; then
  printf 'alarm: audio file is not readable: %s\n' "$alarm_sound" >&2
  exit 1
fi

if ! wake_epoch="$(date -d "$alarm_time" +%s 2>/dev/null)" || [[ ! "$wake_epoch" =~ ^[0-9]+$ ]]; then
  printf 'alarm: invalid wake time: %s\n' "$alarm_time" >&2
  exit 2
fi

if (( wake_epoch <= $(date +%s) )); then
  printf 'alarm: wake time must be in the future: %s\n' "$alarm_time" >&2
  exit 2
fi

privilege_command=$(get_privilege_command) || exit $?
"$privilege_command" rtcwake -d rtc0 -m mem -t "$wake_epoch" -v &&
  mpv --no-resume-playback --loop-file "$alarm_sound"
