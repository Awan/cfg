#!/bin/sh

# In the name of Allah, the Most Gracious, the Most Merciful.
# Notify about connection changes reported by wpa_supplicant's action hook.

if [ "$#" -lt 2 ] || [ -z "$1" ] || [ -z "$2" ]; then
  printf 'Usage: %s INTERFACE CONNECTED|DISCONNECTED\n' "${0##*/}" >&2
  exit 2
fi

interface="$1"
event="$2"

case "$event" in
  DISCONNECTED)
    notify-send -t 3000 'wpa_supplicant' "$interface disconnected!"
    ;;
  CONNECTED)
    ssid=""

    if [ -n "${WPA_CTRL_DIR:-}" ] && [ -n "${WPA_ID:-}" ]; then
      ssid="$(wpa_cli -p "$WPA_CTRL_DIR" -i "$interface" list_networks |
        awk -v id="$WPA_ID" '$1 == id { print $2; exit }')"
    fi

    notify-send -t 3000 'wpa_supplicant' "connected to ${ssid:-unknown network}"
    ;;
  *)
    exit 0
    ;;
esac
