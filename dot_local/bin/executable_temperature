#!/bin/sh

# In the name of Allah, the Most Gracious, the Most Merciful.
# Print the first thermal zone temperature in degrees Celsius.

temperature_file=/sys/class/thermal/thermal_zone0/temp

if [ ! -r "$temperature_file" ]; then
  printf 'temperature: reading is unavailable: %s\n' "$temperature_file" >&2
  exit 1
fi

temperature_millidegrees=$(cat "$temperature_file") || exit 1
case "$temperature_millidegrees" in
  ''|*[!0-9]*)
    printf 'temperature: invalid sensor reading: %s\n' "$temperature_millidegrees" >&2
    exit 1
    ;;
esac

printf '%sC\n' "$((temperature_millidegrees / 1000))"
