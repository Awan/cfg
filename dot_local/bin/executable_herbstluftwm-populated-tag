#!/bin/sh

# Workspace helpers for herbstluftwm that mirror the spectrwm bindings:
#   next | previous  switch to the next/previous workspace that has windows
#   empty            switch to the first empty workspace
#   move-empty       move the focused window to the first empty workspace
#                    and follow it

set -eu

usage() {
    printf 'Usage: %s next|previous|empty|move-empty\n' "$0" >&2
    exit 2
}

if [ "$#" -ne 1 ]; then
    usage
fi

case "$1" in
    next) mode=populated direction=1 ;;
    previous) mode=populated direction=-1 ;;
    empty) mode=empty direction=1 ;;
    move-empty) mode=empty direction=1 ;;
    *) usage ;;
esac

current=$(herbstclient get_attr tags.focus.name)
status=$(herbstclient tag_status)
target=$(printf '%s\n' "$status" | awk \
    -v current="$current" -v direction="$direction" -v mode="$mode" '
    {
        for (i = 1; i <= NF; ++i) {
            tags[++count] = $i
            if (substr($i, 2) == current) {
                current_index = count
            }
        }
    }
    END {
        if (count < 2 || current_index == 0) {
            exit
        }
        for (step = 1; step < count; ++step) {
            target_index = ((current_index - 1 + direction * step) % count + count) % count + 1
            marker = substr(tags[target_index], 1, 1)
            if (mode == "populated" && (marker == ":" || marker == "!")) {
                print substr(tags[target_index], 2)
                exit
            }
            if (mode == "empty" && marker == ".") {
                print substr(tags[target_index], 2)
                exit
            }
        }
    }
')

if [ -z "$target" ]; then
    printf 'herbstluftwm-populated-tag: no matching workspace (%s)\n' "$mode" >&2
    exit 1
fi

if [ "$1" = move-empty ]; then
    herbstclient move "$target"
fi
herbstclient use "$target"
