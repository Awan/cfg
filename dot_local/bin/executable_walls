#!/bin/sh

# Rotate image wallpapers from a directory at a configurable interval.
# Usage: walls [DIRECTORY] [SECONDS]

if [ "$#" -gt 2 ]; then
    printf 'Usage: %s [DIRECTORY] [SECONDS]\n' "${0##*/}" >&2
    exit 2
fi

walls_dir="${1:-$HOME/pix/wall/cuties/dark}"
walls_duration="${2:-60}"

if [ ! -d "$walls_dir" ]; then
    printf 'walls: directory not found: %s\n' "$walls_dir" >&2
    exit 1
fi

case "$walls_duration" in
    ''|*[!0-9]*|0)
        printf 'walls: interval must be a positive integer number of seconds.\n' >&2
        exit 2
        ;;
esac

image_files="$(find "$walls_dir" -maxdepth 1 -type f \( \
    -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o \
    -iname '*.webp' -o -iname '*.gif' \) -print)"

if [ -z "$image_files" ]; then
    printf 'walls: no supported images found in %s\n' "$walls_dir" >&2
    exit 1
fi

hd_wall() {
    # Resize and crop non-1920x1080 images to the target wallpaper size.
    convert "$random_wall" -gravity Center -resize 1920 -crop 1920x1080+0+0 png:- |
        feh --bg-scale -
}

while :; do
    random_wall="$(printf '%s\n' "$image_files" | shuf -n 1)" || exit 1
    resolution="$(identify -format '%wx%h' "$random_wall" 2>/dev/null)" || resolution=

    if [ "$resolution" = "1920x1080" ]; then
        feh --no-fehbg --bg-scale "$random_wall" || exit 1
    else
        hd_wall || exit 1
    fi

    sleep "$walls_duration" || exit 1
done
