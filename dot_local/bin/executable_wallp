░▀░▀░▀░▀░▀▀▀░▀▀▀░▀░░
COMMENT

# A simple shell script to set wallpaper.

WALLPAPER_DIR="$HOME/pix/wall/collection"

while true; do
    # Expand the file list unquoted so shuf gets each path as an argument
    img=$(shuf -n1 -e "$WALLPAPER_DIR"/* 2>/dev/null)

    # Only run feh if a file was actually found
    if [ -f "$img" ]; then
        feh --bg-scale "$img"
    fi

    sleep 60
done
