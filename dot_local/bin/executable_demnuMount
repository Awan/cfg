#!/bin/sh

# Interactively mount an unmounted partition, selecting an existing mountpoint
# or creating one with elevated privileges when requested.

if [ -z "${PRIVILEGE_COMMAND:-}" ]; then
    if command -v doas >/dev/null 2>&1; then
        PRIVILEGE_COMMAND=doas
    else
        PRIVILEGE_COMMAND=sudo
    fi
fi

if pgrep -x dmenu >/dev/null 2>&1; then
    exit 0
fi

if ! command -v dmenu >/dev/null 2>&1; then
    printf '%s\n' 'mount-menu: dmenu is required.' >&2
    exit 127
fi

if ! command -v lsblk >/dev/null 2>&1; then
    printf '%s\n' 'mount-menu: lsblk is required.' >&2
    exit 127
fi

if ! command -v "$PRIVILEGE_COMMAND" >/dev/null 2>&1; then
    printf 'mount-menu: privilege command not found: %s\n' "$PRIVILEGE_COMMAND" >&2
    exit 127
fi

run_privileged() {
    "$PRIVILEGE_COMMAND" "$@"
}

mountable="$(lsblk -rpn -o NAME,SIZE,TYPE,MOUNTPOINTS |
    awk '$3 == "part" && NF == 3 { print $1, "(" $2 ")" }')"

if [ -z "$mountable" ]; then
    notify-send 'No unmounted partitions found.' 2>/dev/null || true
    exit 0
fi

chosen="$(printf '%s\n' "$mountable" | dmenu -i -p 'Mount which drive?' | awk '{print $1}')"
[ -n "$chosen" ] || exit 0

# Let fstab handle partitions that already have a configured mountpoint.
if run_privileged mount "$chosen"; then
    exit 0
fi

mountpoint="$(find /mnt /media /mount /home -maxdepth 5 -type d 2>/dev/null |
    dmenu -i -p 'Choose an existing mountpoint or type a new path:')"
[ -n "$mountpoint" ] || exit 0

if [ ! -d "$mountpoint" ]; then
    create_dir="$(printf '%s\n' No Yes | dmenu -i -p "$mountpoint does not exist. Create it?")"
    [ "$create_dir" = Yes ] || exit 0
    run_privileged mkdir -p -- "$mountpoint" || exit 1
fi

if run_privileged mount -- "$chosen" "$mountpoint"; then
    if pgrep -x dunst >/dev/null 2>&1; then
        notify-send "$chosen mounted to $mountpoint"
    fi
else
    printf 'mount-menu: failed to mount %s at %s\n' "$chosen" "$mountpoint" >&2
    exit 1
fi
