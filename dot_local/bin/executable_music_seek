#!/bin/sh

# In the name of Allah, the Most Gracious, the Most Merciful.
# Seek by the supplied offset in cmus when it is playing, otherwise in MPD.

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
  printf 'Usage: %s OFFSET\n' "${0##*/}" >&2
  exit 2
fi

duration="$1"
cmus_state=""

if command -v cmus-remote >/dev/null 2>&1; then
  cmus_state="$(cmus-remote -Q 2>/dev/null | awk 'NR == 1 { print $2 }')"
fi

if [ "$cmus_state" = "playing" ]; then
  cmus-remote -k "$duration"
else
  mpc seek "$duration"
fi
