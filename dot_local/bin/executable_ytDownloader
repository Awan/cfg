#!/usr/bin/env bash

# Download YouTube video/audio with the desired quality.
# Accept either a full URL or a video ID.

if [[ $# -ne 1 || -z "$1" ]]; then
  printf 'Usage: %s URL_OR_VIDEO_ID\n' "${0##*/}" >&2
  exit 2
fi

url=$1
read -r -p 'What do you want to download, audio or video? ' DEST

if [[ $DEST == 'audio' ]]; then
  cd "$HOME/mus" || exit
else
  cd "$HOME/mus/vid" || exit
fi

youtube-dl -F -- "$url" || exit

read -r -p 'Which format? ' FORMAT
[[ -n "$FORMAT" ]] || exit 0

youtube-dl -f "$FORMAT" --embed-subs --add-metadata -k -- "$url"
