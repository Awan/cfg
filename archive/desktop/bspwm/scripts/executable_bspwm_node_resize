#!/bin/sh

# Adjust the focused bspwm split ratio by the requested edge.

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  printf 'Usage: %s {north|east|south|west} [PIXELS]\n' "${0##*/}" >&2
  exit 2
fi

direction="$1"
size="${2:-10}"

case "$direction" in
  west|east|north|south) ;;
  *)
    printf 'Invalid direction: %s\n' "$direction" >&2
    printf 'Usage: %s {north|east|south|west} [PIXELS]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

case "$size" in
  ''|*[!0-9]*)
    printf 'Invalid size: %s (use a positive integer)\n' "$size" >&2
    exit 2
    ;;
esac

case "$direction" in
  west)  bspc node @west  -r -"$size" || bspc node @east  -r -"$size" ;;
  east)  bspc node @west  -r +"$size" || bspc node @east  -r +"$size" ;;
  north) bspc node @south -r -"$size" || bspc node @north -r -"$size" ;;
  south) bspc node @south -r +"$size" || bspc node @north -r +"$size" ;;
esac
