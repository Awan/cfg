#!/bin/sh

# In the name of Allah, the Most Gracious, the Most Merciful.
# Adjust the bspwm window gap by 3 pixels or restore the default value.

if [ "$#" -ne 1 ]; then
  printf 'Usage: %s {inc|dec|def}\n' "${0##*/}" >&2
  exit 2
fi

case "$1" in
  inc|dec|def) action="$1" ;;
  *)
    printf 'Invalid action: %s\n' "$1" >&2
    printf 'Usage: %s {inc|dec|def}\n' "${0##*/}" >&2
    exit 2
    ;;
esac

default_gaps=3
current_gaps="$(bspc config window_gap)" || exit 1
case "$current_gaps" in
  ''|*[!0-9]*)
    printf 'gaps: invalid current window gap: %s\n' "$current_gaps" >&2
    exit 1
    ;;
esac

case "$action" in
  inc)
    new_gaps=$((current_gaps + 3))
    ;;
  dec)
    new_gaps=$((current_gaps - 3))
    if [ "$new_gaps" -lt 0 ]; then
      new_gaps=0
    fi
    ;;
  def)
    new_gaps=$default_gaps
    ;;
esac

bspc config window_gap "$new_gaps"
