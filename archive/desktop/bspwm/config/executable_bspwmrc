#!/bin/sh
# In the name of Allah, the Most Gracious, the Most Merciful.

# Distribute the ten desktops across connected monitors.

multimonitors()
{
  local total_desktops=10
  local start_from=1
  local monitor_list monitors_connected remaining_desktops remaining_monitors
  local monitor desktops_for_monitor end desktop_names

  monitor_list="$(bspc query -M)" || return 1
  if [ -z "$monitor_list" ]; then
    printf '%s\n' 'bspwmrc: no connected monitors found.' >&2
    return 1
  fi

  monitors_connected="$(printf '%s\n' "$monitor_list" | wc -l)"
  remaining_desktops=$total_desktops
  remaining_monitors=$monitors_connected

  for monitor in $monitor_list; do
    desktops_for_monitor=$((remaining_desktops / remaining_monitors))
    if [ $((remaining_desktops % remaining_monitors)) -gt 0 ]; then
      desktops_for_monitor=$((desktops_for_monitor + 1))
    fi

    if [ "$desktops_for_monitor" -gt 0 ]; then
      end=$((start_from + desktops_for_monitor - 1))
      desktop_names="$(seq "$start_from" "$end")" || return 1
      # Split the generated desktop names into separate bspc arguments.
      # shellcheck disable=SC2086
      bspc monitor "$monitor" -d $desktop_names || return 1
      start_from=$((end + 1))
      remaining_desktops=$((remaining_desktops - desktops_for_monitor))
    fi

    remaining_monitors=$((remaining_monitors - 1))
  done
}

multimonitors

for monitor in unplugged disabled ; do
  bspc config \
    remove_${monitor}_monitors      true
done

bspc config \
  merge_overlapping_monitors        true

# Rules for windows

bspc config external_rules_command "$HOME"/.config/bspwm/external_rules

# Start the active lemonbar-based panel.
"$HOME/.local/bin/mypanel" &

# Border width and gaps between windows

border_width=0
window_gaps=3
bspc config border_width            $border_width
bspc config window_gap              $window_gaps

# Padding

padding="0"
for side in right bottom left ; do
  bspc config ${side}_padding       $padding
done

for side in top right bottom left; do
    bspc config ${side}_monocle_padding 0
done

# Ignore EWMH focus requests. If true, opening new program in already
# opened instance will have direct
# focus too. Like if you're on desktop 8 and you open a URL from mutt, and
# chrome is configured as url launcher, it will send the url to chrome opened
# in 2nd desktop and switch to it.

bspc config ignore_ewmh_focus       false

# On which child should a new window be attached

bspc config initial_polarity        second_child

# Split ration for new windows

bspc config split_ratio             0.50

# If monocle layout, no border to windows.

bspc config borderless_monocle      true

# No gaps as well

bspc config gapless_monocle         true

# Move focus from tiled windows to floating

bspc config directional_focus_tightness low

# Focus the window under the pointer

bspc config focus_follows_pointer   true

# When focusing a monitor/window, put the pointer to its center.

bspc config pointer_follows_monitor true
bspc config pointer_follows_focus   false

# Button used to focusing a window/monitor

bspc config click_to_focus          any

# if there is only one window, set the layout monocle.

bspc config single_monocle          true

# Pointer actions when pressing mod + button

bspc config pointer_action1         move
bspc config pointer_action2         resize_side
bspc config pointer_action3         resize_corner

# Show where new window will be opened

bspc config presel_feedback         true

# Prefix prepended to status program

bspc config status_prefix           'W'

# Insertion scheme

bspc config automatic_scheme        longest_side

# Colors

# Catppuccin Mocha colors used for window feedback and borders.
presel_feedback_color="#94e2d5"
focused_border_color="#a6e3a1"
active_border_color="#f5c2e7"
normal_border_color="#89b4fa"

# Feedback color of preselection

# Window feedback and border colors.
bspc config presel_feedback_color   "$presel_feedback_color"
bspc config focused_border_color    "$focused_border_color"
bspc config active_border_color     "$active_border_color"
bspc config normal_border_color     "$normal_border_color"

# Use Super as the mouse modifier for window actions.
bspc config pointer_modifier mod4
sleep 1

pgrep -f "alacritty -t scratchpad" >/dev/null || alacritty -t 'scratchpad' &
