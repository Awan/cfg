#!/bin/sh     

# In the name of Allah, the most Gracious, the most Merciful.

if [ "$#" -ne 1 ]; then
  printf 'Usage: %s {north|east|south|west}\n' "${0##*/}" >&2
  exit 2
fi

case "$1" in
  north|east|south|west) ;;
  *)
    printf 'Invalid direction: %s\n' "$1" >&2
    exit 2
    ;;
esac

bspc node -p "~$1"
