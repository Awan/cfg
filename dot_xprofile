#!/bin/sh
# In the name of Allah, the Most Gracious, the Most Merciful.

# X resources and additional font directories.
user_resources="$HOME/.Xresources"
user_fonts_dir="$HOME/.local/share/fonts"

# Start each command only when its executable is not already running.
run() {
  if ! pgrep -x "$1" >/dev/null 2>&1; then
    "$@" &
  fi
}

# Load startup scripts installed by X11 packages.
if [ -d /etc/X11/xinit/xinitrc.d ]; then
  for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
    # shellcheck disable=SC1090
    [ -x "$f" ] && . "$f"
  done
  unset f
fi

# Restore the wallpaper previously selected with feh.
if [ -f "$HOME/.fehbg" ]; then
  # shellcheck disable=SC1090
  . "$HOME/.fehbg"
fi

# Identify the desktop session to applications that use XDG metadata.
export DESKTOP_SESSION="${DESKTOP_SESSION:-spectrwm}"
export XDG_SESSION_TYPE=x11

# SXHKD contains BSPWM-specific bindings and is not used by Spectrwm.
[ "$DESKTOP_SESSION" = bspwm ] && run sxhkd

# Merge user-defined X resources when the file exists.
[ -f "$user_resources" ] && xrdb -merge "$user_resources"

# Treat Caps Lock as Super when held, or Escape when tapped (requires xcape).
setxkbmap -option caps:super
xcape -e 'Super_L=Escape'

# Start the X11 compositor.
run picom -b --config "$HOME/.config/picom/picom.conf"

# Set the cursor and register user and system font directories.
xsetroot -cursor_name heart
xset +fp "$user_fonts_dir" && xset fp rehash &
xset +fp /usr/share/fonts/ && xset fp rehash &

# Adjust acceleration on the first recognized touchpad that exposes the
# libinput property. Device names vary across hardware and Xorg drivers.
if command -v xinput >/dev/null 2>&1; then
    xinput --list --name-only | while IFS= read -r device; do
        case "$device" in
            *[Tt]ouchpad*|*[Tt]rackpad*|*Synaptics*|*ELAN*|*Elan*|*elan*)
                if xinput --list-props "$device" 2>/dev/null |
                    grep -q 'libinput Accel Speed'; then
                    xinput --set-prop "$device" "libinput Accel Speed" 0.5
                    break
                fi
                ;;
        esac
    done &
fi

# Hide the pointer when it has been idle.
run unclutter --ignore-scrolling --fork --timeout 1

# Set screen-blanking timing and lock the session when X activates the saver.
xset s 75 45 &
run xss-lock -n "$HOME/.local/bin/dim_screen" --transfer-sleep-lock -- "$HOME/.local/bin/i3lock"

# Start the notification daemon.
run dunst -c "$HOME/.config/dunst/dunstrc"

# Configure connected displays before the window manager starts.
"$HOME/.local/bin/configure-displays"

# vim: ft=sh
