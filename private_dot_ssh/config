Host *
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    ForwardAgent no
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PubkeyAuthentication yes
    HashKnownHosts yes
    VisualHostKey yes
    UpdateHostKeys yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

Host aur.archlinux.org
    User aur
