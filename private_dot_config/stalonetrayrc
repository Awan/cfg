# vim:filetype=config:tw=80:et
# Tray Geometry & Sizing
geometry 1x1-10+3
max_geometry 5x1-10+0
icon_size 17
grow_gravity E
icon_gravity E

# Appearance
background "#1e1e2e"
decorations none
transparent false
parent_bg    false

# Window Manager Hints
window_type dock
window_layer top
skip_taskbar true
sticky true

# Compatibility Flags
kludges force_icons_size
